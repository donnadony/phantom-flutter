# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
# The example is a demo, not a deployed app: its lock buys no reproducibility
# worth having, and a committed one records the SDK floor of whoever last ran
# pub get rather than the floor this package actually declares.
/example/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
